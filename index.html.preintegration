<script>

// ============================
// PRESENTATION ENGINE
// ============================

const slides = document.querySelectorAll(".slide");
let current = 0;

function showSlide(n) {
  if(n < 0 || n >= slides.length) return;

  slides[current].classList.remove("active");
  current = n;
  slides[current].classList.add("active");

  document.getElementById("counter").textContent =
    String(current+1).padStart(2,"0") +
    " / " + String(slides.length).padStart(2,"0");

  document.getElementById("progress").style.width =
    ((current+1)/slides.length*100)+"%";
}

function move(n) {
  showSlide(current+n);
}

document.addEventListener("keydown",e=>{
  if(e.key==="ArrowRight" || e.key===" ") {
    e.preventDefault();
    move(1);
  }
  if(e.key==="ArrowLeft") move(-1);

  if(e.key.toLowerCase()==="f") {
    if(!document.fullscreenElement)
      document.documentElement.requestFullscreen?.();
    else
      document.exitFullscreen?.();
  }
});

// ============================
// EMG SIMULATION
// ============================

const canvas = document.getElementById("signal");
const ctx = canvas.getContext("2d");

let intensity = 0;
let signalRunning = false;
let phase = 0;

function resizeCanvas() {
  const rect = canvas.getBoundingClientRect();
  const dpr = window.devicePixelRatio || 1;

  canvas.width = Math.max(1,rect.width*dpr);
  canvas.height = Math.max(1,rect.height*dpr);

  ctx.setTransform(dpr,0,0,dpr,0,0);
}

window.addEventListener("resize",resizeCanvas);
resizeCanvas();

document.getElementById("intensity").addEventListener("input",e=>{
  intensity = Number(e.target.value);
  signalRunning = intensity > 0;
  updateSignal();
});

function activate() {
  intensity = Math.max(intensity,70);
  document.getElementById("intensity").value = intensity;
  signalRunning = true;
  updateSignal();
}

function release() {
  intensity = 0;
  signalRunning = false;
  document.getElementById("intensity").value = 0;
  updateSignal();
}

function updateSignal() {
  window.dispatchEvent(new CustomEvent("ironhand:emg", {
    detail: intensity
  }));

  document.getElementById("signalStatus").textContent =
    intensity > 0 ? "ACTIVE" : "STANDBY";

  document.getElementById("signalValue").textContent =
    (intensity/100).toFixed(2);

  document.getElementById("power").textContent =
    intensity+"%";

  document.getElementById("motorStatus").textContent =
    intensity > 35 ? "MOVING" : "IDLE";

  document.getElementById("position").textContent =
    intensity > 35 ? "CLOSED" : "OPEN";

  document.querySelectorAll(".finger").forEach(finger=>{
    finger.classList.toggle("closed",intensity>35);
  });
}

// Canvas animation
function drawSignal() {
  const w = canvas.clientWidth;
  const h = canvas.clientHeight;

  if(!w || !h) {
    requestAnimationFrame(drawSignal);
    return;
  }

  ctx.clearRect(0,0,w,h);

  ctx.strokeStyle="#18374c";
  ctx.lineWidth=1;

  for(let y=20;y<h;y+=25) {
    ctx.beginPath();
    ctx.moveTo(0,y);
    ctx.lineTo(w,y);
    ctx.stroke();
  }

  ctx.beginPath();

  for(let x=0;x<w;x++) {
    let noise = signalRunning ?
      (Math.random()-.5)*intensity*.8 : 0;

    let wave =
      Math.sin((x+phase)*.07)*noise;

    let spike =
      signalRunning && x%75<4 ?
      -intensity*.65 : 0;

    let y = h/2 + wave + spike;

    if(x===0) ctx.moveTo(x,y);
    else ctx.lineTo(x,y);
  }

  ctx.strokeStyle="#42ddff";
  ctx.lineWidth=2;
  ctx.shadowBlur=8;
  ctx.shadowColor="#42ddff";
  ctx.stroke();
  ctx.shadowBlur=0;

  phase+=signalRunning?3:1;

  requestAnimationFrame(drawSignal);
}

drawSignal();

// ============================
// ELECTRONIC PROCESS SEQUENCE
// ============================

let processTimer = null;

function runProcess() {
  clearInterval(processTimer);

  const nodes = [1,2,3,4,5];
  let index = 0;

  const status = document.getElementById("processStatus");

  document.querySelectorAll(".node").forEach(n=>{
    n.classList.remove("active");
  });

  const names = [
    "CAPTURING MUSCLE SIGNAL...",
    "AMPLIFYING AND FILTERING...",
    "PROCESSING DATA...",
    "GENERATING CONTROL COMMAND...",
    "ACTUATOR MOVEMENT..."
  ];

  processTimer = setInterval(()=>{
    if(index>=nodes.length) {
      clearInterval(processTimer);
      status.textContent="✓ PROCESS COMPLETED";
      return;
    }

    nodes.forEach(n=>{
      document.getElementById("n"+n)
        .classList.remove("active");
    });

    document.getElementById("n"+nodes[index])
      .classList.add("active");

    status.textContent=names[index];
    index++;

  },900);
}

